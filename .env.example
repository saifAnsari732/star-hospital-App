# ==============================================================================
# STAR HOSPITAL MOBILE APPLICATION - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to `.env` for local development. Never commit `.env` to git.
#
# SECURITY WARNING:
# Only `EXPO_PUBLIC_*` variables are safe for client-side mobile bundling.
# NEVER put Firebase Admin SDK service-account private keys, FCM server keys,
# or ICTHospital Laravel/MySQL database secrets in mobile app environment files.
# ==============================================================================

# --- ICTHospital Laravel Backend REST API ---
# Android Emulator localhost: http://10.0.2.2:8000
# iOS Simulator localhost:  http://localhost:8000
# Physical device / Staging: https://hms-api.starhospital.example.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:8000
EXPO_PUBLIC_API_TIMEOUT_MS=10000

# Set to "false" when connecting to a live ICTHospital backend with mobile API v1 routes.
# Keep "true" for offline demo mode / mock data fallback.
EXPO_PUBLIC_USE_MOCK_API=true

# --- Firebase Client Web/Mobile Configuration ---
# Obtain from Firebase Console -> Project Settings -> Your Apps
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=star-hospital-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=star-hospital-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=star-hospital-app.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# --- Razorpay Payment Gateway (Public Key Only) ---
# Only the publishable Key ID (`EXPO_PUBLIC_RAZORPAY_KEY_ID`) may be present in the mobile client.
# SECURITY WARNING: `RAZORPAY_KEY_ID`, `RAZORPAY_KEY_SECRET`, and `RAZORPAY_WEBHOOK_SECRET`
# belong strictly in the ICTHospital Laravel backend `.env`, NEVER in Expo mobile.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
